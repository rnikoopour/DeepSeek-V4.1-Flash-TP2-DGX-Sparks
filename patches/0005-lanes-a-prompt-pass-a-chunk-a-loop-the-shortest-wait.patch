diff --git a/zig/src/core/lane_host_test.zig b/zig/src/core/lane_host_test.zig
index 4ed97952..d42c973f 100644
--- a/zig/src/core/lane_host_test.zig
+++ b/zig/src/core/lane_host_test.zig
@@ -94,3 +94,65 @@ test "a request the backend refuses fails alone, in the backend's words" {
     try std.testing.expectEqual(Reason.length, plain.wait());
     try std.testing.expectEqual(@as(usize, 64), plain.tokens);
 }
+
+test "a short prompt sent behind a long one in its pass is prefilled first, a chunk at a time between" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    const Slow = struct { // each chunk takes a while, so the short request lands while the long one fills
+        fn hook(_: *anyopaque, _: *lanes.Stream, _: usize) void {
+            std.Io.sleep(std.testing.io, .fromMilliseconds(5), .awake) catch {};
+        }
+    };
+    var target: lanes.fake.Fake = .{ .gpa = gpa, .prefill_chunks = 6, .prefill_hook = Slow.hook };
+    target.prefill_hook_ctx = &target;
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.stepped(), clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    try host.start();
+    defer host.stop();
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        order: *std.atomic.Value(u32),
+        prefilled: ?u32 = null, // the order its prompt pass ended in
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .prefilled => b.prefilled = b.order.fetchAdd(1, .monotonic),
+                .finished => |f| b.done = f.reason,
+                else => {},
+            }
+        }
+        fn wait(b: *@This()) Reason {
+            while (true) {
+                b.mutex.lockUncancelable(std.testing.io);
+                const d = b.done;
+                b.mutex.unlock(std.testing.io);
+                if (d) |r| return r;
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+    var order = std.atomic.Value(u32).init(0);
+    var long_prompt: [400]u32 = undefined;
+    for (&long_prompt, 0..) |*t, i| t.* = @intCast(i % 50 + 1);
+    const short_prompt = [_]u32{ 3, 1, 4, 1, 5 };
+    var long: Box = .{ .order = &order };
+    var short: Box = .{ .order = &order };
+    const rl: Request = .{ .prompt = &long_prompt, .max_tokens = 4 };
+    const rs: Request = .{ .prompt = &short_prompt, .max_tokens = 4 };
+    const e = host.engine();
+    try e.submit(1, &rl, .{ .ctx = &long, .event = Box.event });
+    std.Io.sleep(std.testing.io, .fromMilliseconds(8), .awake) catch {}; // the long pass under way
+    try e.submit(2, &rs, .{ .ctx = &short, .event = Box.event });
+    try std.testing.expectEqual(Reason.length, short.wait());
+    try std.testing.expectEqual(Reason.length, long.wait());
+    try std.testing.expectEqual(@as(?u32, 0), short.prefilled);
+    try std.testing.expectEqual(@as(?u32, 1), long.prefilled);
+    try std.testing.expectEqual(@as(usize, 12), target.prefill_count);
+}
