+    fn prefillStep(ptr: *anyopaque, s: *Stream) anyerror!bool {
+        const x = self(ptr);
+        if (x.refuse_sampled and s.sampling != null) return error.SamplingRefused;
+        const got = try x.lanes.getOrPut(x.gpa, s);
