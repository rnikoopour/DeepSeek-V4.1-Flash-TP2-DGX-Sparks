+    /// The next filling job's next prompt step: the other streams' rounds run between chunks, not after the prompt.
+    fn fillOne(h: *LaneHost) void {
+        if (h.filling.items.len == 0) return;
+        const at = h.fillNext();
+        const job = h.filling.items[at];
+        const first = !job.fill_began;
+        job.fill_began = true;
+        const done = h.core.fillStream(&job.stream, first) catch |e| {
+            h.unfill(job);
+            _ = if (e == error.Cancelled) h.cancel(job) else if (e == error.ContextFull and h.core.activeCount() > 0) h.requeue(job) else h.drop(job, h.words(e));
+            return;
+        };
+        if (!done) return;
+        h.unfill(job);
+        h.prefilled(job, job.began);
+        if (h.deliver(job)) h.remove(job);
+    }
+
+    /// Which filling job goes next (upstream c4d07a54, 77641ba4): foreground before background, then the fewest prompt
+    /// rows left, the oldest of equals; a job passed over `fill_patience` times goes first, so every fill keeps moving.
+    fn fillNext(h: *LaneHost) usize {
+        var at: usize = 0;
+        for (h.filling.items, 0..) |j, i| {
+            const best = h.filling.items[at];
+            const aged = j.fill_wait >= fill_patience;
+            const best_aged = best.fill_wait >= fill_patience;
+            if (aged != best_aged) {
+                if (aged) at = i;
+            } else if (aged) {
+                if (j.fill_wait > best.fill_wait) at = i;
+            } else if (j.request.background != best.request.background) {
+                if (!j.request.background) at = i;
+            } else if (fillLeft(j) < fillLeft(best)) at = i;
+        }
+        for (h.filling.items, 0..) |j, i| j.fill_wait = if (i == at) 0 else j.fill_wait +| 1;
+        return at;
+    }
+
+    const fill_patience = 8;
+
+    fn fillLeft(j: *const Job) u64 {
+        return j.stream.prompt_len -| @max(j.stream.cached, j.stream.fill_at);
+    }
+
+    fn unfill(h: *LaneHost, job: *Job) void {
+        for (h.filling.items, 0..) |j, i| if (j == job) {
+            _ = h.filling.orderedRemove(i);
+            return;
+        };
+    }
