+
+/// `ids` with each image placeholder widened to its image's span (`images` in order); empty when the counts differ.
+fn expand(cx: *Cx, ids: []const u32, token: u32, images: []const api.Image) errors.Refused![]const u32 {
+    var out: std.ArrayList(u32) = .empty;
+    var k: usize = 0;
+    for (ids) |id| {
+        if (id != token) {
+            try out.append(cx.a, id);
+            continue;
+        }
+        if (k >= images.len) return &.{};
+        try out.appendNTimes(cx.a, token, images[k].tokens);
+        k += 1;
+    }
+    return out.items;
+}
+
+/// An image's content digest for the prompt cache: its span length and prepared payload, never 0.
+pub fn imageKey(tokens: u32, payload: []const u8) u64 {
+    var h = std.hash.Wyhash.init(tokens);
+    h.update(payload);
+    return h.final() | 1;
 }
 
