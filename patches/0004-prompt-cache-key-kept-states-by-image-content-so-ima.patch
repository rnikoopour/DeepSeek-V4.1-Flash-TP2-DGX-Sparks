         /// The backend's prompt pass stands at a mark: the cache keeps the stream's state there.
         fn kept(ptr: *anyopaque, s: *lanes.Stream, at: u32) void {
             const job: *Job = @ptrCast(@alignCast(ptr));
             job.reported(); // before a keep can evict the entry the pass restored
-            if (job.request.images.len > 0) return; // a kept state is keyed by tokens: an image's are its placeholder's
-            if (job.host.cache) |store| _ = store.keep(job.request.prompt, at, s, job.request.chunks);
+            if (job.host.cache) |store| _ = store.keep(job.tokens(), at, s, job.request.chunks);
         }
 
         /// Report a restored prefix or its failed copy; an untouched prefix remains kept.
@@ -79,10 +84,23 @@ pub const LaneHost = struct {
             const store = job.host.cache orelse return;
             if (!job.started) return;
             job.stream.reuse.saved = null; // the backend restores before its first chunk; a later keep may free it
-            if (job.stream.reuse_failed) store.resumed(e, job.request.prompt, false) else if (job.stream.cached == e.at) store.resumed(e, job.request.prompt, true);
+            if (job.stream.reuse_failed) store.resumed(e, job.tokens(), false) else if (job.stream.cached == e.at) store.resumed(e, job.tokens(), true);
         }
     };
 
+    /// The prompt as the prompt cache matches it, for a request with images: each span's positions hold ids past any
+    /// vocabulary drawn from its image's key and the position in the span, so a kept state resumes only for the same
+    /// images at the same places. null: no images (the prompt itself), or an unkeyed image (the cache is skipped).
+    pub fn cacheTokens(gpa: Allocator, r: *const Request) error{ OutOfMemory, Unkeyed }!?[]u32 {
+        if (r.images.len == 0) return null;
+        for (r.images) |img| if (img.key == 0 or @as(usize, img.at) + img.tokens > r.prompt.len) return error.Unkeyed;
+        const out = try gpa.dupe(u32, r.prompt);
+        for (r.images) |img| for (out[img.at..][0..img.tokens], 0..) |*t, i| {
+            t.* = 0x8000_0000 | @as(u32, @truncate(std.hash.Wyhash.hash(img.key, std.mem.asBytes(&@as(u64, i)))));
+        };
+        return out;
+    }
+
     pub fn init(gpa: Allocator, io: std.Io, core: *lanes.Engine, info_: Info) LaneHost {
         var enforced = info_;
         enforced.loop_guard = true;
