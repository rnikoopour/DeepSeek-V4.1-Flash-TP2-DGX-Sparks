+
+test "a prompt with images resumes a kept state only for the same images at the same places" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, 8, 7);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer core.deinit();
+    const Snaps = struct {
+        fn bytes(_: *anyopaque, at: u32) u64 {
+            return 64 + 4 * @as(u64, at);
+        }
+        fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!pc.Saved {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            return f.save(@ptrCast(@alignCast(owner.?)), at);
+        }
+        fn restore(_: *anyopaque, _: ?*anyopaque, _: pc.Saved) anyerror!void {
+            return error.BackendRestores;
+        }
+        fn drop(ptr: *anyopaque, saved: pc.Saved) void {
+            const f: *lanes.fake.Fake = @ptrCast(@alignCast(ptr));
+            f.drop(saved);
+        }
+    };
+    var store = pc.Store.init(gpa, .{ .ptr = &target, .vtable = &.{ .bytes = Snaps.bytes, .save = Snaps.save, .restore = Snaps.restore, .drop = Snaps.drop } }, .{ .min_gap = 4, .min_prompt = 0 }, 1 << 20);
+    defer store.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 2 });
+    host.cache = &store;
+    try host.start();
+    defer host.stop();
+    const Box = struct {
+        mutex: std.Io.Mutex = .init,
+        tokens: std.ArrayList(u32) = .empty,
+        cached: ?u32 = null,
+        done: ?Reason = null,
+        fn event(ctx: *anyopaque, _: Id, e: *const Event) void {
+            const b: *@This() = @ptrCast(@alignCast(ctx));
+            b.mutex.lockUncancelable(std.testing.io);
+            defer b.mutex.unlock(std.testing.io);
+            switch (e.*) {
+                .prefilled => |c| b.cached = c,
+                .tokens => |t| b.tokens.appendSlice(gpa, t) catch {},
+                .finished => |f| b.done = f.reason,
+            }
+        }
+        fn run(e: api.Engine, id: Id, r: *const Request) !?u32 {
+            var b: @This() = .{};
+            defer b.tokens.deinit(gpa);
+            try e.submit(id, r, .{ .ctx = &b, .event = event });
+            while (true) {
+                b.mutex.lockUncancelable(std.testing.io);
+                const d = b.done;
+                b.mutex.unlock(std.testing.io);
+                if (d) |reason| {
+                    try std.testing.expectEqual(Reason.length, reason);
+                    return b.cached;
+                }
+                std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake) catch {};
+            }
+        }
+    };
+    const e = host.engine();
+    const pic = 99; // the image token: a span of three at 2
+    const t1 = [_]u32{ 3, 1, pic, pic, pic, 9, 2, 6, 5, 3 };
+    const cat = [_]api.Image{.{ .at = 2, .tokens = 3, .bytes = "cat", .key = 0x1111 }};
+    const dog = [_]api.Image{.{ .at = 2, .tokens = 3, .bytes = "dog", .key = 0x2223 }};
+    const unkeyed = [_]api.Image{.{ .at = 2, .tokens = 3, .bytes = "cat" }};
+    const r1: Request = .{ .prompt = &t1, .images = &cat, .max_tokens = 6, .history_len = 8 };
+    try std.testing.expectEqual(@as(?u32, 0), try Box.run(e, 1, &r1));
+    try std.testing.expectEqual(@as(usize, 1), store.entries.items.len); // kept at the history, the image inside it
+    const t2 = t1 ++ [_]u32{ 7, 7, 5, 3 }; // the next turn
+    const r2: Request = .{ .prompt = &t2, .images = &cat, .max_tokens = 6, .history_len = 12 };
+    try std.testing.expectEqual(@as(?u32, 8), try Box.run(e, 2, &r2));
+    try std.testing.expectEqual(@as(u64, 1), store.counts.hits);
+    const r3: Request = .{ .prompt = &t2, .images = &dog, .max_tokens = 6, .history_len = 12 }; // another image, same tokens
+    try std.testing.expectEqual(@as(?u32, 0), try Box.run(e, 3, &r3));
+    try std.testing.expectEqual(@as(u64, 1), store.counts.hits);
+    const misses = store.counts.misses;
+    const r4: Request = .{ .prompt = &t2, .images = &unkeyed, .max_tokens = 6 }; // an unkeyed image: the cache is skipped
+    try std.testing.expectEqual(@as(?u32, 0), try Box.run(e, 4, &r4));
+    try std.testing.expectEqual(misses, store.counts.misses);
+    try std.testing.expectEqual(@as(u64, 1), store.counts.hits);
+}
+
+test "cache tokens stand each image span for its image and leave the rest of the prompt as it is" {
+    const gpa = std.testing.allocator;
+    const p = [_]u32{ 5, 99, 99, 6, 99 };
+    const a = [_]api.Image{ .{ .at = 1, .tokens = 2, .bytes = "", .key = 7 }, .{ .at = 4, .tokens = 1, .bytes = "", .key = 9 } };
+    const b = [_]api.Image{ .{ .at = 1, .tokens = 2, .bytes = "", .key = 7 }, .{ .at = 4, .tokens = 1, .bytes = "", .key = 11 } };
+    try std.testing.expectEqual(@as(?[]u32, null), try LaneHost.cacheTokens(gpa, &.{ .prompt = &p, .max_tokens = 1 }));
+    const ka = (try LaneHost.cacheTokens(gpa, &.{ .prompt = &p, .images = &a, .max_tokens = 1 })).?;
+    defer gpa.free(ka);
+    const kb = (try LaneHost.cacheTokens(gpa, &.{ .prompt = &p, .images = &b, .max_tokens = 1 })).?;
+    defer gpa.free(kb);
+    try std.testing.expectEqual(@as(u32, 5), ka[0]);
+    try std.testing.expectEqual(@as(u32, 6), ka[3]);
+    for ([_]usize{ 1, 2, 4 }) |i| try std.testing.expect(ka[i] >= 0x8000_0000);
+    try std.testing.expect(ka[1] != ka[2]); // positions in a span differ
+    try std.testing.expectEqualSlices(u32, ka[0..4], kb[0..4]); // the same first image: the same prefix
+    try std.testing.expect(ka[4] != kb[4]);
+    const bad = [_]api.Image{.{ .at = 1, .tokens = 2, .bytes = "" }};
+    try std.testing.expectError(error.Unkeyed, LaneHost.cacheTokens(gpa, &.{ .prompt = &p, .images = &bad, .max_tokens = 1 }));
+}
