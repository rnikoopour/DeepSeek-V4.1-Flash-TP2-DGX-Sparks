+            }
+            fl.head = try m.fillChunk(seq.items[0 .. fl.start + n], fl.start, n, fl.replay);
+            fl.start += n;
+            s.fill_at = @intCast(fl.start);
+            if (s.reuse.hook) |k| if (fl.start < len and fl.start <= fl.replay and (fl.start == fl.last_end or markEnds(s.reuse.marks, fl.start))) k.at(k.ptr, s, @intCast(fl.start));
