# EXPERIMENT (Phase B, only if the standard config leaves headroom): 8 streams on the same 1,048,576-token window. Memory per stream is not documented; watch MemAvailable on rank 0.
# TP2 lane config: DeepSeek-V4.1-Flash-1017 (LibertAI 2.9 bpw EXL3 pack) on two DGX Sparks, TensorFold native engine.
# Rank 0 = Reddie (the fleet endpoint stays at 100.113.138.96:8000), rank 1 = Bluey (the pack's download host).
# Fabric: rail 1 (rocep1s0f0 / enp1s0f0np0, 192.168.192.0/24) and rail 2 (roceP2p1s0f0, 192.168.193.0/24, runtime addresses), RoCE v2 GID index 3.
NODES="tonyspark2@192.168.192.2 tonyspark1@192.168.192.1"
MASTER_IP="192.168.192.2"
TP_PORT=29620
RDMA_HCA="rocep1s0f0,roceP2p1s0f0"
NET_IF="enp1s0f0np0"

BASE=/var/tmp/tf1017-tp2
MODEL_DIR="$BASE/model"                    # config, tokenizer, index, encoding/, chat template and the vision shards of the 2.9 bpw pack
ENGRAM_DIR="/var/tmp/tf1017/engram"        # shards 47 and 48 of deepseek-ai/DeepSeek-V4.1-Flash-1017 (read only; already on every node)
ENGINE_DIR="$BASE/engine-bin"
KIT_DIR="$BASE/kit"
CACHE_DIR="$BASE/cache"                    # rank-cache/rank<R>of2-<hash>.bin and dsv41_token_map.json
LOG_DIR="$BASE/logs"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
LANE=tp2-lane                              # container name on both nodes

HOST=0.0.0.0                               # fleet endpoint: the LAN and the tailnet, no API key
PORT=8000
SERVED_NAME=deepseek-v4.1-flash
SERVER_FLAGS="--no-thinking --max-tokens 32768 --alias glm-5.3-flash --temperature 1.0 --top-p 1.0 --top-k 20"

CONTEXT=1048576
PARALLEL=8
STREAMS=8
# TF_RDMA_GID_INDEX is this engine branch's name for the RoCE v2 GID index of the ring (default 5); our TP4 patch called it TF_RDMA_GID.
ENGINE_ENV="TF_DS_REPLAY_FLOOR=1 TF_SEED_RANDOM=1 TF_TOP_K_MAX=56 TF_RDMA_GID_INDEX=3 NCCL_IB_GID_INDEX=3"
