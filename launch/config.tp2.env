# TP2 lane config: DeepSeek-V4.1-Flash-1017 (LibertAI 2.9 bpw EXL3 pack) on two DGX Sparks, TensorFold native engine.
# Fill in the four <...> values. Rank 0 serves the API; rank 0 must reach both nodes by `ssh -o BatchMode=yes` (keys, no
# prompts), itself included. Both nodes need the same paths below.
NODES="<user>@<rank0-ip> <user>@<rank1-ip>" # rank 0 first: addresses on the direct QSFP link between the two Sparks
MASTER_IP="<rank0-ip>"                     # rank 0's address on that link
TP_PORT=29620
RDMA_HCA="rocep1s0f1,roceP2p1s0f1"         # the RoCE devices on the QSFP link (`ibdev2netdev`); one or both ports' HCAs
NET_IF="enp1s0f1np1"                       # the netdev of that link

BASE=/var/tmp/tf1017-tp2
MODEL_DIR="$BASE/model"                    # config, tokenizer, index, encoding/, chat template and the vision shard of the pack
ENGRAM_DIR="$BASE/engram"                  # shards 47 and 48 of deepseek-ai/DeepSeek-V4.1-Flash-1017 (read only)
ENGINE_DIR="$BASE/engine-bin"
KIT_DIR="$BASE/kit"
CACHE_DIR="$BASE/cache"                    # rank-cache/rank<R>of2-<hash>.bin and dsv41_token_map.json
LOG_DIR="$BASE/logs"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3
LANE=tp2-lane                              # container name on both nodes

HOST=0.0.0.0                               # no API key is set: bind to an address only trusted clients reach, or add --api-key
PORT=8000
SERVED_NAME=deepseek-v4.1-flash
# --prompt-cache-gib: kept prompt states (~6 MiB each at 78K tokens, mirrored on rank 1); the 0.5 GiB default fills quickly.
# 3 GiB and --max-tokens 131072 measured throughput-neutral on a fresh boot (7.2 / 9.0 GiB free per rank, floor 4).
SERVER_FLAGS="--max-tokens 131072 --temperature 1.0 --top-p 1.0 --top-k 20 --prompt-cache-gib 3"

CONTEXT=1048576                            # the served window: 1M tokens, one KV pool shared by the streams
PARALLEL=4                                 # served streams (TF_DS_STREAMS=4, round rows 16: the engine's defaults)
STREAMS=4
# TF_RDMA_GID_INDEX / NCCL_IB_GID_INDEX: the RoCE v2 GID index on RDMA_HCA
# (`cat /sys/class/infiniband/<hca>/ports/1/gid_attrs/types/<i>` reads "RoCE v2"; 3 on stock DGX OS)
# TF_DS_STREAMS=4, round rows 16: the engine's defaults.
# TF_FILL_CHUNKS=1: a long cold prompt runs one 2048-row chunk per piece with the other streams' rounds between (the
# upstream port of what patches 0005-0007 did on the 3ff3b2a pin; unset, a prompt pass runs whole and stalls the pair).
# Larger pieces cost throughput (pre-reboot: 4 chunks 763 tok/s at 8K vs 1,571 at 1 chunk), so keep 1.
# TF_DS_ENGRAM_LEAD=1: Engram's prompt rows read a chunk ahead (upstream 9673a5ee). Pre-reboot on this lane: 32K cold
# prefill 1,413 -> 1,600 tok/s (+13%), 8K 1,411 -> 1,571; replies token-identical on the 12-prompt gate. After a reboot
# every config, flag or not, reads 2,400-2,460 tok/s, so the flag costs nothing and only pays on a fragmented boot.
ENGINE_ENV="TF_DS_REPLAY_FLOOR=1 TF_SEED_RANDOM=1 TF_TOP_K_MAX=56 TF_RDMA_GID_INDEX=3 NCCL_IB_GID_INDEX=3 TF_FILL_CHUNKS=1 TF_DS_ENGRAM_LEAD=1"
